---
import Logo from './Logo.astro';
import { url } from '../lib/url';
import { phoneHref } from '../data/site';

const path = Astro.url.pathname;
const cartaHref = url('carta/');
const onCarta = path.includes('/carta');
---

<header class="site-header">
  <a class="brand" href={url()}>
    <Logo />
  </a>
  <nav class="nav-desktop" aria-label="Secciones">
    <a href={url('#concepto')}>Concepto</a>
    <a href={url('#dia')}>El día</a>
    <a href={cartaHref} aria-current={onCarta ? 'page' : undefined}>Carta</a>
    <a href={url('#local')}>El local</a>
    <a href={url('#visita')}>Visita</a>
    <a class="btn" href={phoneHref}>Reservar</a>
  </nav>
  <a class="btn header-reserve" href={phoneHref}>Reservar</a>
  <details class="nav-mobile">
    <summary>Menú</summary>
    <div class="nav-panel">
      <a href={url('#concepto')}>Concepto</a>
      <a href={url('#dia')}>El día</a>
      <a href={cartaHref} aria-current={onCarta ? 'page' : undefined}>Carta</a>
      <a href={url('#local')}>El local</a>
      <a href={url('#visita')}>Visita</a>
      <a href={url('#instagram')}>Instagram</a>
    </div>
  </details>
</header>
