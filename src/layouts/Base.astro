---
import '@fontsource/marcellus/latin-400.css';
import '@fontsource/playfair-display/latin-400.css';
import '@fontsource/playfair-display/latin-600.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import '@fontsource/playfair-display/latin-600-italic.css';
import '@fontsource/lora/latin-400.css';
import '@fontsource/lora/latin-400-italic.css';
import '@fontsource/lora/latin-600.css';
import '@fontsource/sacramento/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { site, phoneHref } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('og.jpg'), Astro.site);
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#123A20" />
    <meta name="geo.region" content="ES-A" />
    <meta name="geo.placename" content="Alcoy" />
    <link rel="icon" href={url('favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={`${site.name} · Alcoy`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    {json && <script type="application/ld+json" set:html={json} />}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <a class="reserve-bar" href={phoneHref}>
      <span>Reservar</span>
      <span>{site.phoneDisplay}</span>
    </a>
    <script>
      document.querySelectorAll('.nav-panel a').forEach((link) => {
        link.addEventListener('click', () => {
          link.closest('details')?.removeAttribute('open');
        });
      });
    </script>
  </body>
</html>
